# Copy to `.env` and adjust. Values under docker compose `environment:`
# (DATABASE_URL, RABBITMQ_URL, ...) override these inside containers.

ENVIRONMENT=development
LOG_LEVEL=INFO
JSON_LOGS=true

# --- Infrastructure credentials (used by docker-compose) ---------------------
POSTGRES_USER=triage
POSTGRES_PASSWORD=triage_secret
POSTGRES_DB=triage
RABBITMQ_USER=triage
RABBITMQ_PASSWORD=triage_secret

# --- Local (non-docker) development ------------------------------------------
DATABASE_URL=postgresql://triage:triage_secret@localhost:5432/triage
RABBITMQ_URL=amqp://triage:triage_secret@localhost:5672/
UPLOAD_DIR=./data/uploads
STUDENT_MODEL_DIR=./models/student

# --- Embeddings (dimension MUST match vector(N) in database/schema.sql) ------
EMBEDDING_MODEL=intfloat/multilingual-e5-base
EMBEDDING_DIM=768

# --- Deduplication ------------------------------------------------------------
DEDUP_SIMILARITY_THRESHOLD=0.88
DEDUP_RADIUS_KM=0.5

# --- Teacher LLM / VLM (any OpenAI-compatible endpoint) -----------------------
# OpenAI:  LLM_BASE_URL=https://api.openai.com/v1
# Ollama:  LLM_BASE_URL=http://host.docker.internal:11434/v1  (no key needed)
# vLLM:    LLM_BASE_URL=http://vllm:8000/v1
LLM_ENABLED=false
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
VLM_ENABLED=false
VLM_MODEL=gpt-4o-mini

# --- DistillMesh router -------------------------------------------------------
ROUTER_CONFIDENCE_THRESHOLD=0.80
ROUTER_MARGIN_THRESHOLD=0.15
TEACHER_COST_PER_CALL_USD=0.002

# --- Neuro-symbolic engine ----------------------------------------------------
Z3_TIMEOUT_MS=10000
SYMBOLIC_MAX_ROUNDS=4
