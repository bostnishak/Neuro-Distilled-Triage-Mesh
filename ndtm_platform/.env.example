# =============================================================================
# NDTM Platform Environment Configuration
# =============================================================================
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Infrastructure ---
DATABASE_URL=postgresql://triage:triage_secret@localhost:5432/triage
REDIS_URL=redis://localhost:6379/0
RABBITMQ_URL=amqp://triage:triage_secret@localhost:5672/
UPLOAD_DIR=./data/uploads
STUDENT_MODEL_DIR=./models/student

# --- Model & Vector Embeddings ---
EMBEDDING_MODEL=intfloat/multilingual-e5-base
EMBEDDING_DIM=768
DEDUP_SIMILARITY_THRESHOLD=0.88

# --- Teacher LLM Gateway ---
LLM_ENABLED=false
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
TEACHER_COST_PER_CALL_USD=0.002

# --- Semantic Router ---
ROUTER_CONFIDENCE_THRESHOLD=0.80
ROUTER_MARGIN_THRESHOLD=0.15

# --- Neuro-Symbolic Verification Engine ---
Z3_TIMEOUT_MS=10000
SYMBOLIC_MAX_ROUNDS=4

# --- Multi-Agent Consensus ---
AGENT_CONSENSUS_THRESHOLD=0.85

# --- Continuous Learning ---
RETRAIN_TRIGGER_COUNT=1000
