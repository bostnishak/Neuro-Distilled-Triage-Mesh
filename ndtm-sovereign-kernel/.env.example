# ==============================================================================
# NEURO-DISTILLED TRIAGE MESH (NDTM-9000) — SOVEREIGN ENVIRONMENT CONFIGURATION
# ==============================================================================

# Core System Environment
NDTM_ENV=development
PROJECT_NAME="NDTM-9000 Sovereign Kernel"
DEBUG=true
LOG_LEVEL=INFO
API_V1_STR="/api/v1"
CORS_ORIGINS=["http://localhost:5173","http://localhost:80","http://localhost:3000","http://127.0.0.1:5173"]

# PostgreSQL 16 + PostGIS + pgvector (Carrier-Grade Database)
POSTGRES_USER=ndtm_kernel
POSTGRES_PASSWORD=KernelRootSecret2026!
POSTGRES_DB=ndtm_sovereign_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://ndtm_kernel:KernelRootSecret2026!@postgres:5432/ndtm_sovereign_db
DATABASE_URL_SYNC=postgresql://ndtm_kernel:KernelRootSecret2026!@postgres:5432/ndtm_sovereign_db
DB_POOL_SIZE=30
DB_MAX_OVERFLOW=20
DB_TIMEOUT_SECONDS=15

# Redis 7.2 (GCRA Leaky-Bucket Rate Limiter & Idempotency Locking)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=
REDIS_CACHE_TTL_SECONDS=3600
REDIS_RATE_LIMIT_BURST=100
REDIS_RATE_LIMIT_RATE_PER_SEC=20

# RabbitMQ 3.13 (AMQP Topology with Dead Letter Queue & Publisher Confirms)
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=ndtm_admin
RABBITMQ_PASSWORD=MeshRabbitSecret2026!
RABBITMQ_VHOST=ndtm_vhost
RABBITMQ_URL=amqp://ndtm_admin:MeshRabbitSecret2026!@rabbitmq:5672/ndtm_vhost
OUTBOX_POLL_INTERVAL_MS=200
OUTBOX_BATCH_SIZE=50

# Cryptographic & Offensive Security Keys (RFC 7519 JWT & Ed25519 Signatures)
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_ME_IN_PROD_USE_OPENSSL_RAND_HEX_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7
HMAC_SECRET_SALT=CHANGE_ME_SECURE_HMAC_SALT_FOR_PII_PSEUDONYMIZATION

# Asymmetric Ed25519 HITL Keypair (Hex Encoded 32-byte Private & 32-byte Public)
# Generate with: python -c "from cryptography.hazmat.primitives.asymmetric import ed25519; k=ed25519.Ed25519PrivateKey.generate(); print('PRIV:', k.private_bytes_raw().hex()); print('PUB:', k.public_key().public_bytes_raw().hex())"
ED25519_PRIVATE_KEY_HEX=CHANGE_ME_GENERATE_RANDOM_ED25519_PRIVATE_HEX
ED25519_PUBLIC_KEY_HEX=CHANGE_ME_CORRESPONDING_ED25519_PUBLIC_HEX

# POSIX Shared Memory Zero-Copy Arena (C++20 to Python Tensor Pipeline)
SHM_ARENA_NAME=/ndtm_tensor_arena
SHM_ARENA_SIZE_MB=64
SHM_SLOT_COUNT=64
SHM_SLOT_SIZE_BYTES=1048576

# Engine 3: Spatio-Temporal Self-Exciting Hawkes Process
HAWKES_BASELINE_MU=0.05
HAWKES_EXCITATION_ALPHA=0.65
HAWKES_DECAY_BETA=1.25
HAWKES_SPATIAL_SIGMA_METERS=750.0
HAWKES_MERGE_THRESHOLD=0.82
HAWKES_FORECAST_HORIZON_MINUTES=30

# Engine 4: Control-Theoretic PID-Regulated Entropy Router
PID_KP=0.045
PID_KI=0.012
PID_KD=0.008
PID_TARGET_LATENCY_MS=20.0
PID_ANTI_WINDUP_IMAX=0.15
ENTROPY_TAU_MIN=0.12
ENTROPY_TAU_MAX=0.65
ENTROPY_TAU_DEFAULT=0.28
MAHALANOBIS_CHI2_THRESHOLD=16.81
ONNX_STUDENT_MODEL_PATH=/distilled_models/student_model_int8.onnx
TEACHER_API_KEY=ndtm_teacher_synthetic_simulated_key_2026
TEMPERATURE_CALIBRATION=1.05

# Engine 6: Neuro-Symbolic Z3 MaxSMT Optimizer & Pareto Solver
Z3_TIMEOUT_MS=5000
Z3_MAX_ITERATIONS=3
CRITICAL_URGENCY_SLA_MINUTES=45
HIGH_URGENCY_SLA_MINUTES=90
NORMAL_URGENCY_SLA_MINUTES=180

# Engine 7: Causal Digital Twin & Pearl's do-Calculus
CAUSAL_CASCADE_HORIZON_MINUTES=240
SUBMODULAR_INTERVENTION_BUDGET=2

# Engine 8: Byzantine Multi-Krum & Rényi Differential Privacy
FEDERATED_MAX_BYZANTINE_NODES=1
DP_MAX_EPSILON=5.0
DP_TARGET_DELTA=1e-5
DP_CLIP_NORM=1.0
DP_NOISE_MULTIPLIER=1.15

# Edge DSP & Optics Thresholds
OPTICS_MIN_LAPLACIAN_VARIANCE=85.0
OPTICS_MAX_IMAGE_BYTES=10485760
AUDIO_SAMPLING_RATE_HZ=16000
AUDIO_FFT_WINDOW_SIZE=4096
AUDIO_MEL_BANDS=16

# Telemetry, OpenTelemetry & Prometheus
PROMETHEUS_METRICS_ENABLED=true
PROMETHEUS_PORT=9090
OTEL_SERVICE_NAME=ndtm-sovereign-kernel
OTEL_EXPORTER_OTLP_ENDPOINT=http://prometheus:9090
