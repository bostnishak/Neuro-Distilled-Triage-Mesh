# =====================================================================
# NEURO-DISTILLED TRIAGE MESH (NDTM-9000 OMEGA)
# Production Automation & Day-2 Operations Makefile
# =====================================================================

SHELL := /bin/bash
PYTHON := python

.PHONY: help test-prod test-all docker-up-prod docker-down-prod warm-gate verify-all

help:
	@echo "NDTM v3.0 Production Commands:"
	@echo "  make test-prod       - Run 17 production remediation tests"
	@echo "  make test-all        - Run full 37-test suite (Phases 1-40)"
	@echo "  make docker-up-prod  - Launch production stack with PgBouncer HA"
	@echo "  make docker-down-prod- Tear down production containers"
	@echo "  make warm-gate       - Trigger pre-flight warmup gate check"
	@echo "  make verify-all      - Full zero-defect verification check"

test-prod:
	$(PYTHON) -m pytest backend/tests/production_remediation -v

test-all:
	$(PYTHON) -m pytest backend/tests -v

docker-up-prod:
	docker compose -f docker-compose.prod.yml up -d --build

docker-down-prod:
	docker compose -f docker-compose.prod.yml down -v

warm-gate:
	$(PYTHON) -c "from backend.core.preflight_warmup_gate import PREFLIGHT_GATE; PREFLIGHT_GATE.run_preflight_warmup(); print('Gate readiness:', PREFLIGHT_GATE.check_readiness())"

verify-all: test-all warm-gate
	@echo "[NDTM-OMEGA] ALL 40 PHASES VERIFIED WITH ZERO DEFECTS."
