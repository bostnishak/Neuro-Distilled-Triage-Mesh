    {
      "name": "q.triage.process",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-dead-letter-exchange": "ndtm.dlx.direct",
        "x-dead-letter-routing-key": "dlq.triage",
        "x-message-ttl": 60000
      }
    },
    {
      "name": "q.shadow.evaluate",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {}
    },
    {
      "name": "q.dlq.failed",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {}
    }
  ],
  "exchanges": [
    {
      "name": "ndtm.events.topic",
      "vhost": "/",
      "type": "topic",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
