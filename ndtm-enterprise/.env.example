# ==============================================================================
# Neuro-Distilled Triage Mesh (NDTM) — Enterprise Monorepo Environment Config
# ==============================================================================

# --- Application Core ---
PROJECT_NAME=ndtm-enterprise
ENVIRONMENT=production
DEBUG=false
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000
FRONTEND_PORT=3000

# --- Security & JWT Authentication (RS256 / Cryptographic 64-Byte Secret) ---
JWT_SECRET_KEY=9a4f2c8d1e3b7a5f0e9d8c7b6a5f4e3d2c1b0a9f8e7d6c5b4a3f2e1d0c9b8a7f
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
HMAC_SECRET_SALT=7d8e9f0a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e

# --- PostgreSQL 16 + pgvector + PostGIS ---
POSTGRES_USER=ndtm_db_user
POSTGRES_PASSWORD=ndtm_db_secure_password_2026!
POSTGRES_DB=ndtm_enterprise_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://ndtm_db_user:ndtm_db_secure_password_2026!@postgres:5432/ndtm_enterprise_db
EMBEDDING_DIMENSION=384

# --- Redis 7.2 (Semantic Cache & Sliding-Window Rate Limiter) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=ndtm_redis_secure_auth_token_2026!
REDIS_URL=redis://:ndtm_redis_secure_auth_token_2026!@redis:6379/0
REDIS_CACHE_TTL_SECONDS=86400
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_BURST_MAX=30

# --- RabbitMQ 3.13 AMQP Broker ---
RABBITMQ_USER=ndtm_user
RABBITMQ_PASSWORD=ndtm_secret_amqp_pass_2026!
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_VHOST=/
RABBITMQ_URL=amqp://ndtm_user:ndtm_secret_amqp_pass_2026!@rabbitmq:5672//
OUTBOX_POLL_INTERVAL_MS=250

# --- DistillMesh & ONNX Student Calibration ---
ONNX_STUDENT_MODEL_PATH=distilled_models/student_int8.onnx
TEACHER_MODEL_BACKEND=mock_heuristic
TEACHER_API_KEY=mock_dev_teacher_key
ENTROPY_THRESHOLD=0.28
OOD_SIMILARITY_THRESHOLD=0.75
TEMPERATURE_CALIBRATION=1.2
SHADOW_SAMPLE_RATE=0.15

# --- Image Forensics Quality Gates ---
MIN_LAPLACIAN_VARIANCE=85.0
MIN_PIXEL_INTENSITY=20.0
MAX_PIXEL_INTENSITY=245.0
MAX_IMAGE_FILE_SIZE_BYTES=10485760

# --- Neuro-Symbolic Z3 SMT Solver ---
Z3_TIMEOUT_MS=10000
MAX_CORRECTION_ITERATIONS=3
CRITICAL_URGENCY_SLA_MINUTES=45
